# ── 运行环境 ──
ENV=production

# ── 服务器 ──
SERVER__PORT=3000

# ── 数据库（PostgreSQL）──
DATABASE__DATABASE_TYPE=postgresql
DATABASE__HOST=postgres
DATABASE__PORT=5432
DATABASE__USER=quantanote
DATABASE__PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DATABASE__DATABASE=quantanote
DATABASE__MAX_CONNECTIONS=20

# ── 认证 ──
AUTH__JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
AUTH__ACCESS_TOKEN_EXPIRATION_MINUTES=15
AUTH__REFRESH_TOKEN_EXPIRATION_DAYS=7

# ── Redis ──
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0

# ── 存储 ──
STORAGE__BACKEND_TYPE=local
STORAGE__BASE_PATH=/app/sync_data
# STORAGE__BUCKET=
# STORAGE__ENDPOINT=
# STORAGE__REGION=us-east-1
# STORAGE__ACCESS_KEY=
# STORAGE__SECRET_KEY=
# STORAGE__WEBDAV_URL=
# STORAGE__WEBDAV_USERNAME=
# STORAGE__WEBDAV_PASSWORD=

# ── 邮件 ──
EMAIL__ENABLED=false
# EMAIL__SMTP_HOST=
# EMAIL__SMTP_PORT=465
# EMAIL__SMTP_USERNAME=
# EMAIL__SMTP_PASSWORD=
# EMAIL__FROM_NAME=QuantaNote
# EMAIL__FROM_EMAIL=
