{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "QuantaNote",
    "version": "0.1.0",
    "identifier": "com.quantanote.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "QuantaNote",
                "x": 580,
                "y": 150,
                "width": 720,
                "height": 560,
                "minWidth": 520,
                "minHeight": 420,
                "decorations": false,
                "transparent": false
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$HOME/.quantanote/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
